{
  "name": "agrigo-api",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "engines": {
    "node": ">=22.9",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file=.env src/database/cli.ts latest",
    "migrate:rollback": "tsx --env-file=.env src/database/cli.ts rollback",
    "migrate:status": "tsx --env-file=.env src/database/cli.ts status",
    "migrate:make": "tsx --env-file=.env src/database/cli.ts make",
    "seed": "tsx --env-file=.env src/database/cli.ts seed",
    "vnpay:ipn": "tsx --env-file=.env scripts/vnpay-ipn.ts",
    "smoke": "tsx scripts/smoke.ts",
    "openapi": "tsx --env-file=.env scripts/export-openapi.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.52",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
