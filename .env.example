NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ChangeMe-db-password
DB_NAME=agrigo_dev_v1
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

TRUST_PROXY=false
CORS_ORIGINS=*
DOCS_ENABLED=true
RATE_LIMIT_MAX=100

# Generate two secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=ChangeMe-access-signing-secret-replace-for-local-development
JWT_REFRESH_SECRET=ChangeMe-refresh-signing-secret-replace-for-local-development
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=10

SEED_ADMIN_EMAIL=admin@agrigo.local
SEED_ADMIN_PASSWORD=ChangeMe123!

APP_NAME=AgriGo
# Generate a third secret with: openssl rand -base64 48
OTP_SECRET=ChangeMe-otp-signing-secret-replace-for-local-development
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

MAIL_TRANSPORT=smtp
MAIL_FROM="AgriGo <no-reply@agrigo.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
JOBS_ENABLED=true

SHIPPING_FEE=0

# Configure both VNPay credentials or leave both unset.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
VNPAY_EXPIRE_MINUTES=15
FRONTEND_PAYMENT_RESULT_URL=http://localhost:5173/payment/result

DB_ACQUIRE_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=65000
SHUTDOWN_DELAY_SECONDS=0
SHUTDOWN_TIMEOUT_SECONDS=20

MAIL_LEASE_SECONDS=120
